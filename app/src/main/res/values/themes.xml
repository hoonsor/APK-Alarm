    <color name="ic_launcher_background">#FF0E1117</color>

    <style name="Theme.HoonsorAlarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
